    "predeploy": "vite build",
    "build": "vite build",
    "deploy": "cp dist/index.html dist/404.html && gh-pages -d dist && rm -rf dist && echo 'Deploy & Cleanup Complete'",
    "lint": "eslint .",
    "preview": "vite preview",
    "email": "email dev --dir ./server/emails",
    "server": "tsx watch ./server/index.jsx"
  },
